# ==========================================
# ClassSathi Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/classsathi

# Authentication & Security
JWT_SECRET=classsathi_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# School Operational Settings
SCHOOL_TIMEZONE=Asia/Kolkata
LOW_ATTENDANCE_THRESHOLD=75

# Optional Integrations (Placeholders for future notification providers)
EMAIL_PROVIDER_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

SMS_PROVIDER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SENDER_ID=
